{
    "$schema": "https://lnav.org/schemas/format-v1.schema.json",
    "static_file_server_log": {
        "title": "Static file server JSON log",
        "description": "JSON logs emitted by static-file-server spdlog formatter",
        "file-type": "json",
        "file-pattern": ".*\\.trace\\.log$",
        "level-field": "level",
        "level": {
            "critical": 60,
            "error": 50,
            "warn": 40,
            "warning": 40,
            "info": 30,
            "debug": 20,
            "trace": 10
        },
        "value": {
            "ts": {
                "kind": "integer",
                "identifier": false
            },
            "level": {
                "kind": "string",
                "identifier": false
            },
            "msg": {
                "kind": "string"
            },
            "trace_id": {
                "kind": "string",
                "hidden": true
            },
            "span_id": {
                "kind": "string",
                "hidden": true
            }
        },
        "timestamp-field": "ts",
        "timestamp-divisor": 1000,
        "body-field": "msg",
        "line-format": [
            {
                "field": "__timestamp__"
            },
            " ",
            {
                "field": "level",
                "text-transform": "uppercase",
                "auto-width": true
            },
            " ",
            {
                "field": "msg"
            }
        ],
        "sample": [
            {
                "line": "{\"ts\":1772393112436,\"level\":\"info\",\"msg\":\"Received 78 bytes\"}",
                "level": "info"
            },
            {
                "line": "{\"ts\":1772393112437,\"level\":\"warning\",\"msg\":\"High latency detected\"}",
                "level": "warning"
            },
            {
                "line": "{\"ts\":1772393112438,\"level\":\"error\",\"msg\":\"Failed to open file\"}",
                "level": "error"
            }
        ]
    }
}
